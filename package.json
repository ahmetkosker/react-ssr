{
  "name": "react-ssr",
  "packageManager": "yarn@4.0.2",
  "version": "1.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": {
    "email": "exarons@gmail.com",
    "name": "Ahmet Köşker",
    "url": "https://github.com/ahmetkosker"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "i18next": "^23.11.5",
    "react": "^18.2.0",
    "react-cookie": "^7.1.4",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1",
    "@types/cookie-parser": "^1",
    "@types/express": "^4.17.21",
    "@types/i18next": "^13.0.0",
    "@types/i18next-fs-backend": "^1.1.5",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-i18next": "^8.1.0",
    "concurrently": "^8.0.1",
    "esbuild": "^0.19.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "scripts": {
    "start": "node scripts/checkBuild.mjs && node src/server/build/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "test": "node --require ts-node/register --test tests/**/*.test.ts",
    "ci": "yarn lint && yarn typecheck && yarn test && yarn build",
    "build:client": "esbuild src/client/pages/**/client.ts --bundle --minify --loader:.js=jsx --outdir=src/client/dist/",
    "build:server": "esbuild src/server/server.tsx --bundle --platform=node --loader:.js=jsx --outfile=src/server/build/server.js",
    "build:client:watch": "esbuild src/client/pages/**/client.ts --bundle --sourcemap --loader:.js=jsx --outdir=src/client/dist/ --watch",
    "build:server:watch": "esbuild src/server/server.tsx --bundle --platform=node --sourcemap --loader:.js=jsx --outfile=src/server/build/server.js --watch",
    "build": "yarn build:client && yarn build:server && yarn tw:build",
    "tw": "tailwindcss -i ./src/client/style/index.css -o ./src/client/dist/bundle.css --watch",
    "tw:build": "tailwindcss -i ./src/client/style/index.css -o ./src/client/dist/bundle.css --minify",
    "start:dev": "yarn build && concurrently \"yarn build:client:watch\" \"yarn build:server:watch\" \"yarn tw\" \"nodemon\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
